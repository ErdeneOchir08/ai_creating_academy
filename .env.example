# Public Supabase connection values from Project Settings > API. Use either
# the modern publishable key or the legacy anon key; this project supports both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only Supabase secret key (Project Settings > API Keys). This is used
# only by the contract-signing service after the authenticated user passes the
# required identity check. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# Telegram alerts for new payment requests. Keep both values secret and never
# prefix them with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional public site address used to include an admin-payment link in alerts.
NEXT_PUBLIC_SITE_URL=""

# SMTP for student payment-status emails. Keep the app password private.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Mind Academy"

# Cloudflare Stream for private paid-course videos. Keep all values server-only.
# Add these only after the Cloudflare Stream account has been created.
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_CODE=""
